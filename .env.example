# Copia este archivo a .env y cambia los valores.
POSTGRES_DB=reportes
POSTGRES_USER=reportes
POSTGRES_PASSWORD=cambia-esta-contrasena

APP_ENV=development
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_HORAS=8

# Mensaje de WhatsApp a padres de familia (opcionales)
PLANTEL_NOMBRE=CBTis 147
# Texto al final del mensaje: teléfono y horario de Orientación Educativa
ORIENTACION_CONTACTO=

# Correo para las alertas a Subdirección (opcional: sin SMTP_HOST las alertas solo aparecen en la bandeja)
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Puerto público del frontend con docker compose (la API queda en /api/v1 del mismo puerto)
HTTP_PORT=8080
